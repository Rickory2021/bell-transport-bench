# .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# Flatten-sync export output
project-export-files/

# Local copies of references (make refs-fetch); never committed
.references/

# Runs, benchmarks and notebooks made with uncommitted changes; only the README is committed
workspace/*
!workspace/README.md

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
