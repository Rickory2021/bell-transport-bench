# %%
from html import escape

from qiskit import qasm3
from bellbench.views.base import emit, fold, img

CASES = {"ibm2016": ("{{ c[2].run }}", "{{ c[3].run }}", "cases 1 and 2", "case 3"),
         "contemporary": ("{{ c[5].run }}", "{{ c[6].run }}", "cases 4 and 5", "case 6"),
         "hyperbolic": ("{{ c[8].run }}", "{{ c[9].run }}", "cases 7 and 8", "case 9")}


def transpiled(processor):
    """The workbench's view of a graph's baseline and protected runs, with their compiled circuits in dropdowns."""
    *runs, base_cases, protected_case = CASES[processor]
    for run, cases in zip(runs, (base_cases, protected_case)):
        result = wb.fetch(REPORTED, run)
        display(wb.show(result, step=True, timeline=True))
        fig = qasm3.loads(result.record["compiled"]["ZZ"]).draw("mpl", idle_wires=False, fold=40, scale=0.55)
        drawing = img(fig)
        plt.close(fig)
        emit([fold(f"{cases}: {run}, the compiled ZZ circuit, drawn", drawing)]
             + [fold(f"{cases}: {run}, the compiled {basis} circuit as OpenQASM 3", f"<pre>{escape(text)}</pre>")
                for basis, text in result.record["compiled"].items()])

