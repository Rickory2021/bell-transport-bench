REPORTED = "{{ REPORTED }}"
NOISE, SHOTS, BASE_SEED = "{{ B.runs[0].noise }}", {{ B.shots }}, {{ B.base_seed }}  # every benchmark here shares them
MADE = WORK / "made"  # the runs this notebook makes; the recorded runs stay where the payloads put them
BASES = ("XX", "YY", "ZZ")


def show(function):
    """The package's own code for a function, as the payload holds it, so what is shown is what runs. It is shown as a
    Markdown code block, so each viewer highlights it in its own theme, light or dark."""
    display(Markdown(f"```python\n{inspect.getsource(function)}```"))


def make(benchmark):
    """Make every run the benchmark file lists, from the files written above, into a folder of this notebook's own."""
    folder = run_benchmark(benchmark, root=MADE)
    runs = yaml.safe_load((folder / "bp.data.runs.yaml").read_text())["runs"]
    print(f"made {len(runs)} runs of {benchmark}: {', '.join(runs)}")


def made(benchmark):
    """The folder of the benchmark as this notebook made it."""
    return current_benchmark(benchmark, root=MADE)


def recorded(benchmark):
    """The folder of the benchmark as the repository recorded it, from the payloads."""
    return current_benchmark(benchmark)


def circuit_views(circuit, folded=False):
    """A circuit file as the workbench shows it, compiled here with the benchmarks' noise profile and seed, without
    simulating: the graph and the written circuit, then the step-through folded, then one fold holding a fold per
    basis: its compiled circuit, its timelines and its OpenQASM 3. folded=True, for the appendix, keeps only the text lines open and folds the graph, the written
    circuit and the cost table too."""
    run = CircuitRun(circuit, NOISE, SHOTS, BASE_SEED).compile()
    view = Compiled.of_run(run)
    bases = "".join(fold(f"{basis}: the compiled circuit, its timeline and its OpenQASM 3",
                         basis_html(view, basis) + f"<pre>{escape(circuit_to_qasm(run.compiled[basis].compiled))}</pre>").content
                    for basis in BASES)
    parts = [*show_parts(view, step=True), fold("Compiled circuits, by basis", bases)]
    if folded:
        inside = [part for part in parts
                  if part.kind == "png" or (part.kind == "html" and not part.content.startswith("<details"))]
        lines = [part for part in parts if part.kind == "markdown"]
        rest = [part for part in parts if part not in inside and part not in lines]  # the folds, and any other kind
        pictures = "".join(f'<img style="max-width:100%" src="data:image/png;base64,{part.content}">'
                           if part.kind == "png" else part.content for part in inside)
        parts = [*lines, fold(f"{circuit}: the graph, the written circuit and its cost per basis", pictures), *rest]
    emit(parts)


SERIES = dict(zip(configs.CORE_PROCESSORS, ("#2a78d6", "#eb6834", "#1baf7a")))  # validated categorical slots 1 to 3
NAME = {"ibm2016": "2016-inspired", "contemporary": "contemporary", "hyperbolic": "hyperbolic-inspired"}
INK, MUTED, GRID, AXIS, SURFACE = "#0b0b0b", "#898781", "#e1e0d9", "#c3c2b7", "#fcfcfb"


def chart(figsize, grid="y"):
    """A figure in the notebook's one chart style: a light surface, a recessive grid on one axis, no top or right
    spine. Every chart colours a graph the same way, by SERIES."""
    fig, ax = plt.subplots(figsize=figsize, facecolor=SURFACE)
    ax.set_facecolor(SURFACE)
    ax.grid(axis=grid, color=GRID, lw=0.8)
    ax.set_axisbelow(True)
    for side in ("top", "right"):
        ax.spines[side].set_visible(False)
    for side in ("left", "bottom"):
        ax.spines[side].set_color(AXIS)
    ax.tick_params(colors=MUTED, labelsize=9)
    return fig, ax


def finish(fig, title, note, legend_ax=None):
    """Title top left, a muted note top right, and, for a chart of several graphs, a legend of them under the title."""
    if legend_ax is not None:
        legend_ax.legend(loc="lower left", bbox_to_anchor=(0, 1.0), ncol=3, frameon=False, fontsize=9,
                         handletextpad=0.3, columnspacing=1.4, labelcolor=INK)
    fig.text(0.01, 0.985, title, fontsize=12, fontweight="bold", color=INK, va="top")
    fig.text(0.99, 0.985, note, fontsize=9, color=MUTED, va="top", ha="right")
    fig.tight_layout(rect=(0, 0, 1, 0.93 if legend_ax is not None else 0.95))
    display(fig)
    plt.close(fig)


def ladder(benchmark):
    """One graph's extended benchmark as a horizontal bar per run, in the order its benchmark file lists the runs: F of
    the kept shots with one standard error, labelled with its acceptance where the run discards shots. The protected
    case is the solid bar. The axis starts near the lowest F, not at 0, and its label says so."""
    t = read_table(made(benchmark) / "comparison.csv").query("simulation == 'noisy'").reset_index(drop=True)
    processor = t.processor.iloc[0]
    colour = SERIES[processor]
    y = np.arange(len(t))[::-1]  # the file's first run on top
    protected = [run == f"ghz-uncompute-vacancy-{processor}" for run in t.run]
    low = float(np.floor((t.fidelity - t.fidelity_se).min() / 0.002) * 0.002) - 0.002
    high = float((t.fidelity + t.fidelity_se).max())
    fig, ax = chart((8, 0.38 * len(t) + 1.4), grid="x")
    ax.barh(y, t.fidelity - low, left=low, height=0.62, color=colour, alpha=None, zorder=2,
            edgecolor=SURFACE, linewidth=2)
    for bar, p in zip(ax.patches, protected):
        bar.set_alpha(1 if p else 0.38)
    ax.errorbar(t.fidelity, y, xerr=t.fidelity_se, fmt="none", ecolor=INK, elinewidth=1, capsize=2, zorder=3)
    for yi, f, e, a, p in zip(y, t.fidelity, t.fidelity_se, t.acceptance, protected):
        ax.annotate(f"{f:.4f}" + ("" if a == 1 else f", kept {a:.3f}") + (" (protected case)" if p else ""), (f + e, yi),
                    xytext=(6, 0), textcoords="offset points", va="center", fontsize=8, color=INK if p else MUTED)
    ax.set_yticks(y, t.run)
    ax.tick_params(axis="y", colors=INK, length=0)
    ax.set_xlim(low, high + 0.35 * (high - low))  # room right for the labels
    ax.set_xlabel(f"F of the kept shots (± 1 SE); the axis starts at {low:.3f}, not 0", color=INK, fontsize=10)
    finish(fig, f"Every run on the {NAME[processor]} graph", benchmark)


def beside_record(benchmark, extra=()):
    """Each run this notebook made beside the same run as recorded: F and acceptance from each, whether the counts
    and the compiled circuits are identical, and whether the files the record names hash to the files written here.
    `extra` adds (made folder, recorded folder) pairs for runs made outside the benchmark. A different commit or
    package version is listed below the table, not counted as a difference."""
    pairs = [(made(benchmark) / run, recorded(benchmark) / run)
             for run in yaml.safe_load((made(benchmark) / "bp.data.runs.yaml").read_text())["runs"]]
    rows, provenance = [], set()
    for here, then in [*pairs, *extra]:
        mine, rec = (yaml.safe_load((f / "bp.data.result.yaml").read_text()) for f in (here, then))
        f_here, a_here = noisy_scores(here)
        f_then, a_then = noisy_scores(then)
        refs = [rec["circuit"], rec["noise_control"]["processor"], rec["noise_control"]["noise"]]
        rows.append({"run": then.name, "F here": f"{f_here:.4f}", "F recorded": f"{f_then:.4f}",
                     "acceptance here": f"{a_here:.3f}", "acceptance recorded": f"{a_then:.3f}",
                     "identical": (f_here, a_here) == (f_then, a_then) and mine["compiled"] == rec["compiled"]
                                  and (here / "counts.csv").read_text() == (then / "counts.csv").read_text(),
                     "same files": all(configs.content_hash(WORK / r["path"]) == r["hash"] for r in refs)})
        provenance |= {key for key in ("commit", "packages") if mine["provenance"][key] != rec["provenance"][key]}
    table = pd.DataFrame(rows).set_index("run")
    display(table)
    print("every run identical to its record, counts, circuits and numbers" if table.identical.all() and table["same files"].all()
          else "SOME RUNS DIFFER from their records: see the table")
    print("provenance that differs, not counted:", ", ".join(sorted(provenance)) or "none")


def noisy_scores(folder):
    """F of the kept shots and the acceptance of a run folder's noisy simulation, from its simulations table."""
    row = read_table(folder / "simulations.csv").query("simulation == 'noisy'").iloc[0]
    return float(row.fidelity), float(row.acceptance)


