for level in (1, 2):
    out = generate_preset_pass_manager(optimization_level=level, target=baseline.nc.target,
                                       initial_layout=list(range(baseline.nc.num_qubits)),
                                       seed_transpiler=baseline.seeds["transpile"]).run(zz)
    measured = [out.find_bit(i.qubits[0]).index for i in out.data if i.operation.name == "measure"]
    levels.append((level, sum(n for gate, n in out.count_ops().items() if gate in ("cz", "cx", "swap")),
                   ", ".join(map(str, measured)), "yes" if measured == list(baseline.nc.ports) else "no"))
