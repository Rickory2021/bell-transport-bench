heading("Output: each basis circuit's gates, compiled at level 1")
gates = list(dict.fromkeys(g for c in compiled.values() for g in c.compiled.count_ops()))
md_table(["Gate", *compiled], [(g, *(c.compiled.count_ops().get(g, 0) for c in compiled.values())) for g in gates])

