MADE = WORK / "made"  # the runs this notebook makes; the recorded runs stay where the payloads put them
BASES = ("XX", "YY", "ZZ")


def heading(text):
    """A divider and a bold label above a block of output, so each part of a cell's output says what it is."""
    display(Markdown(f"---\n\n**{text}**"))


def show(function):
    """The package's own code for a function, as the payload holds it, so what is shown is what runs, under a divider
    naming it. It is shown as a Markdown code block, so each viewer highlights it in its own theme, light or dark."""
    lines, start = inspect.getsourcelines(function)
    path = "src/" + inspect.getsourcefile(function).replace("\\", "/").split("/src/", 1)[1]  # its path in the repository
    where = f"[{path}, lines {start} to {start + len(lines) - 1}]({SOURCE}/{path}#L{start}-L{start + len(lines) - 1})"
    display(Markdown(f"---\n\n**bellbench's code:** `{function.__module__}.{function.__qualname__}`, from {where}\n\n"
                     f"```python\n{''.join(lines)}```"))


def md_table(columns, rows):
    """A few rows as a Markdown table, which each viewer draws in its own style, with no index column."""
    head = "| " + " | ".join(columns) + " |\n|" + "---|" * len(columns) + "\n"
    display(Markdown(head + "".join("| " + " | ".join(str(v) for v in row) + " |\n" for row in rows)))


def make(benchmark):
    """Make every run the benchmark file lists, from the files written above, into a folder of this notebook's own."""
    folder = run_benchmark(benchmark, root=MADE)
    runs = yaml.safe_load((folder / "bp.data.runs.yaml").read_text())["runs"]
    print(f"made {len(runs)} runs of {benchmark}: {', '.join(runs)}")


def made(benchmark):
    """The folder of the benchmark as this notebook made it."""
    return current_benchmark(benchmark, root=MADE)


def recorded(benchmark):
    """The folder of the benchmark as the repository recorded it, from the payloads."""
    return current_benchmark(benchmark)


def circuit_views(circuit, folded=False):
    """A circuit file as the workbench shows it, compiled here with the benchmarks' noise profile and seed, without
    simulating: the graph and the written circuit, then the step-through folded, then one fold holding a fold per
    basis: its compiled circuit, its timelines and its OpenQASM 3. folded=True, for the appendix, keeps only the text lines open and folds the graph, the written
    circuit and the cost table too."""
    run = CircuitRun(circuit, NOISE, SHOTS, BASE_SEED).compile()
    view = Compiled.of_run(run)
    bases = "".join(fold(f"{basis}: the compiled circuit, its timeline and its OpenQASM 3",
                         basis_html(view, basis) + f"<pre>{escape(circuit_to_qasm(run.compiled[basis].compiled))}</pre>").content
                    for basis in BASES)
    parts = [*show_parts(view, step=True), fold("Compiled circuits, by basis", bases)]
    if folded:
        inside = [part for part in parts
                  if part.kind == "png" or (part.kind == "html" and not part.content.startswith("<details"))]
        lines = [part for part in parts if part.kind == "markdown"]
        rest = [part for part in parts if part not in inside and part not in lines]  # the folds, and any other kind
        pictures = "".join(f'<img style="max-width:100%" src="data:image/png;base64,{part.content}">'
                           if part.kind == "png" else part.content for part in inside)
        parts = [*lines, fold(f"{circuit}: the graph, the written circuit and its cost per basis", pictures), *rest]
    emit(parts)


