# %%
sweep("starting-excitation", "starting excitation",
      [("baseline-contemporary", "#9aa5b8"), ("move-contemporary", "#137665"), ("spare-xx-contemporary", "#7139cc"),
       ("baseline-ibm2016", "#c9b0a0"), ("move-ibm2016", "#c62639"), ("path-xx-ibm2016", "#e07b00")])
study_table("starting-excitation")

