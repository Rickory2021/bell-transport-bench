#@title Check: the same run rebuilt in plain Qiskit and Aer, without bellbench
from qiskit import ClassicalRegister, qasm3
from qiskit.circuit.library import get_standard_gate_name_mapping
from qiskit.providers import BackendV2, Options
from qiskit.transpiler import InstructionProperties, PassManager, QubitProperties, Target
from qiskit.transpiler.passes import ALAPScheduleAnalysis, PadDelay
from qiskit_aer import AerSimulator
from qiskit_aer.noise import NoiseModel, ReadoutError

# Step 1 by hand: read the two config files as plain YAML, the way any script would.
profile = yaml.safe_load((WORK / f"config/noise/bp.data.noise.{NOISE}.yaml").read_text())
graph = yaml.safe_load((WORK / "config/processor/bp.data.processor.contemporary.yaml").read_text())
n, qubit, readout = len(graph["qubits"]), profile["qubit"], profile["qubit"]["readout_error"]
couplers = [tuple(e) for e in graph["edges"]] + [tuple(reversed(e)) for e in graph["edges"]]  # a CZ either way

# The Target: every native gate on every qubit or coupler, each with Boston's median error and duration, every qubit
# with the same T1 and T2, then the measurement, reset and delay. Its measurement error is the mean of the two readout
# directions; the noise model below replaces it with both directions.
gate = get_standard_gate_name_mapping()
target = Target(num_qubits=n, dt=profile["time_step"],
                qubit_properties=[QubitProperties(t1=qubit["t1_relaxation_time"], t2=qubit["t2_dephasing_time"])] * n)
for name, spec in profile["gates"].items():
    where = couplers if spec["qubits"] == 2 else [(i,) for i in range(n)]
    target.add_instruction(gate[name], {w: InstructionProperties(error=spec["error_probability"], duration=spec["duration"])
                                        for w in where})
target.add_instruction(gate["measure"], {(i,): InstructionProperties(
    error=(readout["reads_1_when_0"] + readout["reads_0_when_1"]) / 2, duration=profile["measure"]["duration"]) for i in range(n)})
target.add_instruction(gate["reset"], {(i,): InstructionProperties(duration=profile["reset"]["duration"]) for i in range(n)})
target.add_instruction(gate["delay"], {(i,): None for i in range(n)})


class TargetOnly(BackendV2):
    """A backend that carries only the Target, so Aer can read a noise model from it."""

    def __init__(self, target):
        super().__init__(name="target-only")
        self._target = target

    target = property(lambda self: self._target)
    max_circuits = property(lambda self: None)
    _default_options = classmethod(lambda cls: Options())

    def run(self, *args, **kwargs):
        raise NotImplementedError("this backend only carries a Target")


# Aer builds the gate errors and the relaxation, during gates and idle delays alike, from the Target. Readout is left
# out there and added per qubit here, with its two directions apart: reads 1 when 0, and reads 0 when 1.
noise_model = NoiseModel.from_backend(TargetOnly(target), readout_error=False)
p10, p01 = readout["reads_1_when_0"], readout["reads_0_when_1"]
for i in range(n):
    noise_model.add_readout_error(ReadoutError([[1 - p10, p10], [p01, 1 - p01]]), [i])
heading("Check 1: the noise model")
print("the same noise model as bellbench's:", noise_model == run.nc.noise_model)

# Step 2 by hand: the written circuit, three times, each with its basis rotation on the ports and a 2-bit "port"
# register measuring them. ZZ measures as is, XX applies H first, and YY applies S dagger then H.
written = qasm3.loads(yaml.safe_load((WORK / "config/circuit/bp.data.circuit.{{ prot.contemporary.circuit }}.yaml").read_text())["circuit"])
a, b = graph["ports"]


def gates_of(circuit):
    """Each instruction as (name, physical qubits, parameters), to compare two circuits whatever their register names."""
    return [(i.operation.name, tuple(circuit.find_bit(q).index for q in i.qubits), tuple(map(float, i.operation.params)))
            for i in circuit.data]


heading("Check 2: the compiled gates")
by_hand = {}
for basis in BASES:
    circuit = written.copy()
    port = ClassicalRegister(2, "port")
    circuit.add_register(port)
    for q in (a, b):
        if basis == "YY":
            circuit.sdg(q)
        if basis in ("XX", "YY"):
            circuit.h(q)
    circuit.measure([a, b], [port[0], port[1]])
    # Steps 3 and 4 by hand: compile at level 1 on the qubits as written, with bellbench's transpiler seed, then
    # schedule as late as possible and fill each idle period with a delay.
    hand = generate_preset_pass_manager(optimization_level=1, target=target, initial_layout=list(range(n)),
                                        seed_transpiler=run.seeds["transpile"]).run(circuit)
    by_hand[basis] = PassManager([ALAPScheduleAnalysis(target=target), PadDelay(target=target)]).run(hand)
    print(f"{basis}: the same gates on the same qubits as bellbench's:", gates_of(hand) == gates_of(run.compiled[basis].compiled))

# Step 5 by hand: one Aer job runs the three scheduled circuits with bellbench's noisy seed, so the shots match
# shot for shot.
counts = AerSimulator(noise_model=noise_model, seed_simulator=run.seeds["noisy"]).run(
    [by_hand[basis] for basis in BASES], shots=SHOTS).result().get_counts()


def correlator(counts):
    """The basis's correlator over the kept shots. Each count's key holds one bit string per register, the port
    register first, since it was added last; the rest are the vacancy reads. A shot is kept when every read gave 0,
    and adds +1 when the two port bits agree and -1 when they differ."""
    kept = {}
    for key, k in counts.items():
        ports, *checks = key.split()
        if set("".join(checks)) <= {"0"}:
            kept[ports] = kept.get(ports, 0) + k
    total = sum(kept.values())
    return sum((1 if bits[0] == bits[1] else -1) * k for bits, k in kept.items()) / total, total


# F from the three correlators, as in section 3, and the acceptance: the kept shots over every shot run.
(xx, kx), (yy, ky), (zz_, kz) = (correlator(c) for c in counts)
f_hand, acceptance_hand = (1 + xx - yy + zz_) / 4, (kx + ky + kz) / (3 * SHOTS)
heading("Check 3: F and acceptance")
print(f"plain Qiskit: F = {f_hand:.6f}, acceptance {acceptance_hand:.6f}")
print(f"bellbench:    F = {run.scores['noisy'].accepted.value:.6f}, acceptance {run.scores['noisy'].acceptance:.6f}")
print("the same numbers" if (round(f_hand, 12), round(acceptance_hand, 12)) == (round(run.scores["noisy"].accepted.value, 12),
      round(run.scores["noisy"].acceptance, 12)) else "DIFFERENT numbers")

# %% [markdown]
# ---
#
# ## {{ H["s3"] }}
#
# **On each of three processor graphs, create the Bell pair $\lvert\beta_{00}\rangle = (\lvert 00\rangle + \lvert 11\rangle)/\sqrt{2}$ between two fixed qubits, the ports, measure how close it comes, and test one strategy that protects it.**
#
# - **Why it is hard:** a two-qubit gate acts only between neighbours on the graph, so a pair made at one port must be moved to the other, and each added gate adds noise.
# - **How close it comes:** we measure the two ports in three bases and combine the three correlators into the fidelity. F = 1 is the target exactly; F above 1/2 shows entanglement.
#
# $$F = \frac{1 + \langle XX\rangle - \langle YY\rangle + \langle ZZ\rangle}{4}$$
#
# **The nine cases:** each graph under three conditions.
#
# | Graph | Ideal | Noisy | Noisy, protected |
# |---|---|---|---|
# | 2016-inspired | Case 1 | Case 2 | Case 3 |
# | Contemporary | Case 4 | Case 5 | Case 6 |
# | Hyperbolic-inspired | Case 7 | Case 8 | Case 9 |
#
# <details><summary><b>The linear algebra behind the formula</b></summary>
#
# **The states**
#
# - A qubit's state is a unit vector in $\mathbb{C}^2$; two qubits share one in $\mathbb{C}^4$, with basis $\lvert 00\rangle$, $\lvert 01\rangle$, $\lvert 10\rangle$ and $\lvert 11\rangle$.
# - The target, $\lvert\beta_{00}\rangle = (\lvert 00\rangle + \lvert 11\rangle)/\sqrt{2}$, is the vector $(1, 0, 0, 1)/\sqrt{2}$.
# - The other three Bell states: $\lvert\beta_{01}\rangle = (\lvert 01\rangle + \lvert 10\rangle)/\sqrt{2}$, $\lvert\beta_{10}\rangle = (\lvert 00\rangle - \lvert 11\rangle)/\sqrt{2}$ and $\lvert\beta_{11}\rangle = (\lvert 01\rangle - \lvert 10\rangle)/\sqrt{2}$.
#
# **The Pauli matrices**
#
# - X = [[0, 1], [1, 0]], Y = [[0, -i], [i, 0]] and Z = [[1, 0], [0, -1]].
#
# **The correlators**
#
# - $\langle BB\rangle$ is the expectation value of $B \otimes B$ in the pair's state $\rho$: $\mathrm{Tr}(\rho\,(B \otimes B))$, for $B$ one of $X$, $Y$ and $Z$.
# - From shots: $\langle BB\rangle = P(00) + P(11) - P(01) - P(10)$.
#
# **Why the formula gives F**
#
# - $\lvert\beta_{00}\rangle\langle\beta_{00}\rvert = (I \otimes I + X \otimes X - Y \otimes Y + Z \otimes Z)/4$, so $F = \langle\beta_{00}\rvert\,\rho\,\lvert\beta_{00}\rangle$, the overlap of the prepared state with the target, is the formula above.
#
# **What each basis sees**
#
# - ZZ sees a bit flip, XX a phase flip, and YY either; all three together tell $\lvert\beta_{00}\rangle$ from the other three Bell states.
#
# **Why 1/2**
#
# - A state that is not entangled cannot have F above 1/2, so 1/2 is the line a classical correlation cannot cross.
#
# The full statement of the task, with its sources, is [CHALLENGE.md]({{ link("docs/CHALLENGE.md") }}).
#
# </details>

# %% [markdown]
# ### {{ H["s3-1"] }}
#
# **Each case reports F with its standard error, the acceptance (the fraction of shots kept), and the circuit's cost,** as the challenge's five measures require. Each run takes {{ "{:,}".format(B.shots) }} shots per basis, simulated ideal and noisy with seeds derived from one base seed, {{ B.base_seed }}, so every run repeats exactly.
#
# - **F after postselection** is F of the kept shots; **F raw** is F of every shot. A protected result is never shown without its acceptance.
# - **Standard error:** a correlator c from N shots has variance $(1 - c^2)/N$; the three bases are separate shots, so $\mathrm{SE}(F) = \sqrt{\sum \mathrm{var}}/4$, with N the kept shots. Two runs differ by more than chance when their difference exceeds about two combined standard errors, $\sqrt{\mathrm{SE}_1^2 + \mathrm{SE}_2^2}$; this notebook gives each difference in those units.
# - **Cost:** two-qubit gates, depth, SWAPs and qubits used, from the compiled circuit before scheduling, and the scheduled duration.
# - **Two-qubit gates per accepted pair:** the gates divided by the acceptance, what each kept pair costs.
# - **Infidelity removed per rejection:** $(F - F_{\mathrm{raw}})/(1 - p)$, how much a check lowers $1 - F$ for each unit of shots it discards.

